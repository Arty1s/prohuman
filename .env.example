# Public URL of the backend/CMS. Leave empty to use the built-in mock adapter.
PROHUMAN_API_URL=https://api.example.com

# Optional server-only token. Never prefix this with NEXT_PUBLIC_.
PROHUMAN_API_TOKEN=

# Canonical public frontend URL used by SEO, share links and callbacks.
NEXT_PUBLIC_SITE_URL=https://www.prohuman.sk
